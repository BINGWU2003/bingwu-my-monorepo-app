    "path-browserify": "^1.0.1",
    "pinia": "catalog:",
    "pinyin-pro": "^3.27.0",
    "qs": "^6.14.0",
    "responsive-storage": "^2.2.0",
    "sortablejs": "^1.15.6",
    "tippy.js": "^6.3.7",
