# 平台本地运行端口号
VITE_PORT = 8848

# 是否隐藏首页 隐藏 true 不隐藏 false
VITE_HIDE_HOME = false

# 读取配置文件路径
VITE_PUBLIC_PATH = /

# 路由历史模式（Hash模式传"hash"、HTML5模式传"h5"、Hash模式带base参数传"hash,base参数"、HTML5模式带base参数传"h5,base参数"）
VITE_ROUTER_HISTORY = "hash"

# 是否在打包时使用cdn替换本地库 替换 true 不替换 false
VITE_CDN = false

# 是否启用gzip压缩或brotli压缩
# 压缩时不删除原始文件的配置：gzip、brotli、both、none（默认）
# 压缩时删除原始文件的配置：gzip-clear、brotli-clear、both-clear、none（默认）
VITE_COMPRESSION = "none"

# 后端 API 地址
VITE_API_BASE_URL = http://localhost:4000
