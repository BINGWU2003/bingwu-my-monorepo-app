# API 基础地址（开发：/api 走 vite 代理；生产见 .env.production）
VITE_API_BASE_URL = '/api'

# 开发代理目标（仅本地开发生效）
VITE_API_PROXY_TARGET = http://localhost:4000

# 线上参考：Mobile https://bingwu-my-monorepo-app-mobile.vercel.app | API https://bingwu-my-monorepo-app-1.onrender.com

# 是否启用 eruda 调试工具（仅开发环境有效）
VITE_ENABLE_ERUDA = "false"

# 平台打包路径
VITE_PUBLIC_PATH = /
